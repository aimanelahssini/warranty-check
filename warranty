#!/usr/bin/env bash
# Start the warranty server if it isn't running, then open the page.
DIR="$(dirname "$(readlink -f "$0")")"
PORT="${WARRANTY_PORT:-8765}"
URL="http://127.0.0.1:$PORT"
if ! curl -s -o /dev/null "$URL/"; then
  nohup python3 "$DIR/warranty_server.py" >/dev/null 2>&1 &
  for _ in $(seq 20); do curl -s -o /dev/null "$URL/" && break; sleep 0.1; done
fi
xdg-open "$URL" >/dev/null 2>&1 &
